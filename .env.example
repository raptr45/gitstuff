# --- APP CONFIGURATION ---
NEXT_PUBLIC_BASE_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

# Generate secret via: openssl rand -base64 32
# Docs: https://better-auth.com/docs/installation#set-environment-variables
BETTER_AUTH_SECRET=your_32_character_secret_here

# --- AUTH PROVIDERS ---
# Create an OAuth app at: https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# --- DATABASE ---
# Example: postgresql://user123:mypassword@localhost:5432/mydb
DATABASE_URL=postgresql://username:password@localhost:5432/db_name
